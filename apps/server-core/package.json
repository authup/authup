{
    "name": "@authup/server-core",
    "type": "module",
    "version": "1.0.0-beta.63",
    "description": "This is a standalone application.",
    "license": "AGPL-3.0-only",
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "files": [
        "dist"
    ],
    "scripts": {
        "debug": "node --inspect dist/cli/index.mjs start",
        "cli": "node dist/cli/index.mjs",
        "cli-dev": "node --loader ts-node/esm src/cli/index.ts",
        "cli-dev-src": "nodemon --watch src --exec \"npm run build:server && node dist/cli/index.mjs\"",
        "cli-dev-dist": "nodemon --watch dist --exec \"node dist/cli/index.mjs\"",
        "build:server:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
        "build:server:js": "tsdown",
        "build:server": "npm run build:server:js && npm run build:server:types && npm run build:swagger && npm run build:config-schema",
        "build:swagger": "trapi generate",
        "build:config-schema": "node scripts/emit-config-schema.mjs",
        "build": "rimraf ./dist && npm run build:server",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.ts",
        "test:mysql": "cross-env DB_TYPE=mysql DB_HOST=127.0.0.1 DB_USERNAME=root DB_PASSWORD=start123 DB_DATABASE=app vitest run --config test/vitest.config.ts",
        "test:psql": "cross-env DB_TYPE=postgres DB_HOST=127.0.0.1 DB_USERNAME=postgres DB_PASSWORD=start123 DB_DATABASE=app vitest run --config test/vitest.config.ts",
        "test:coverage": "cross-env NODE_ENV=test vitest run --config test/vitest.config.ts --coverage",
        "test:schema-drift": "node scripts/assert-schema-drift.mjs",
        "test:migration-latest": "node scripts/verify-latest-migration.mjs",
        "check:types": "tsc -p tsconfig.test.json"
    },
    "engines": {
        "node": "^22.13.0 || ^23.5.0 || >=24.0.0"
    },
    "keywords": [
        "auth",
        "authentication",
        "authorization",
        "oauth2",
        "openid-connect",
        "server",
        "api",
        "iam",
        "rbac",
        "abac",
        "ldap",
        "jwt",
        "identity",
        "access-control",
        "token",
        "session"
    ],
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/authup/authup.git",
        "directory": "apps/server-core"
    },
    "bugs": {
        "url": "https://github.com/authup/authup/issues"
    },
    "homepage": "https://github.com/authup/authup#readme",
    "dependencies": {
        "@authup/access": "^1.0.0-beta.63",
        "@authup/core-http-kit": "^1.0.0-beta.63",
        "@authup/core-kit": "^1.0.0-beta.63",
        "@authup/errors": "^1.0.0-beta.63",
        "@authup/i18n": "^1.0.0-beta.63",
        "@authup/kit": "^1.0.0-beta.63",
        "@authup/server-config-kit": "^1.0.0-beta.63",
        "@authup/server-config": "^1.0.0-beta.63",
        "@authup/server-console-kit": "^1.0.0-beta.63",
        "@authup/server-kit": "^1.0.0-beta.63",
        "@authup/specs": "^1.0.0-beta.63",
        "@ebec/http": "^4.3.2",
        "@hapic/oauth2": "^4.0.2",
        "@peculiar/x509": "^2.0.0",
        "@rapiq/adapter-memory": "^2.2.0",
        "@rapiq/adapter-sql": "^2.2.0",
        "@rapiq/adapter-typeorm": "^2.2.0",
        "@rapiq/codec-url": "^2.2.0",
        "@rapiq/core": "^2.2.0",
        "@routup/basic": "^3.0.0",
        "@routup/cors": "^2.0.0",
        "@routup/decorators": "^5.0.0",
        "@routup/logger": "^2.0.0",
        "@routup/prometheus": "^4.0.0",
        "@routup/rate-limit": "^4.0.0",
        "@routup/swagger-ui": "^4.0.0",
        "@simplewebauthn/server": "^13.3.2",
        "@validup/zod": "^2.0.1",
        "better-sqlite3": "^13.0.3",
        "change-case": "^5.4.4",
        "citty": "^0.2.2",
        "confinity": "^2.0.1",
        "dotenv": "^17.4.1",
        "dycraft": "^1.1.0",
        "eldin": "^1.3.0",
        "envix": "^1.5.0",
        "hapic": "^3.0.2",
        "ilingo": "^6.1.0",
        "ldapjs": "^3.0.7",
        "locter": "^4.1.1",
        "mysql2": "^3.24.1",
        "node-cron": "^4.6.0",
        "nodemailer": "^9.0.5",
        "orkos": "^1.1.1",
        "otpauth": "^9.5.1",
        "pg": "^8.23.0",
        "prom-client": "^15.1.3",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.2.2",
        "routup": "^6.1.0",
        "smob": "^1.6.1",
        "tsyringe": "^4.10.0",
        "typeorm": "1.1.0",
        "typeorm-extension": "^4.1.0",
        "uncrypto": "^0.1.3",
        "validup": "^2.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@authup/server-test-kit": "^1.0.0-beta.63",
        "@faker-js/faker": "^10.6.0",
        "@trapi/cli": "^2.0.5",
        "@types/ldapjs": "^3.0.6",
        "@types/nodemailer": "^8.0.0",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^7.2.1",
        "jest-serial-runner": "^1.2.1",
        "nodemon": "^3.1.14",
        "supertest": "^7.2.2",
        "testcontainers": "^12.1.0",
        "ts-node": "^10.8.2",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.0.14"
    },
    "publishConfig": {
        "access": "public"
    }
}
