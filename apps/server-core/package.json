    "@types/ldapjs": "^3.0.6",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vuecs/button": "^1.0.1",
    "@vuecs/core": "^3.1.0",
    "@vuecs/countdown": "^2.0.1",
    "@vuecs/design": "^1.0.1",
    "@vuecs/elements": "^1.2.0",
    "@vuecs/forms": "^4.0.1",
    "@vuecs/icons-font-awesome": "^1.0.1",
    "@vuecs/list": "^1.0.1",
    "@vuecs/navigation": "^3.0.1",
    "@vuecs/overlays": "^1.0.1",
    "@vuecs/pagination": "^2.1.0",
    "@vuecs/table": "^1.1.1",
