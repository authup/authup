{
    "name": "authup",
    "type": "module",
    "version": "1.0.0-beta.58",
    "description": "This is the CLI for the authup ecosystem.",
    "license": "AGPL-3.0-only",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        }
    },
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "cli": "node dist/index.mjs",
        "cli-dev": "npm run build && npm run cli",
        "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "rimraf ./dist && npm run build:js && npm run build:types",
        "check:types": "tsc -p tsconfig.test.json",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.ts",
        "test:smoke": "node test/smoke/run.mjs",
        "test:smoke:packed": "node test/smoke/run.mjs --packed"
    },
    "engines": {
        "node": "^22.13.0 || ^23.5.0 || >=24.0.0"
    },
    "bin": {
        "authup": "dist/index.mjs"
    },
    "keywords": [
        "auth",
        "authentication",
        "authorization",
        "cli",
        "command-line",
        "oauth2",
        "server",
        "identity"
    ],
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/authup/authup.git",
        "directory": "packages/authup"
    },
    "bugs": {
        "url": "https://github.com/authup/authup/issues"
    },
    "homepage": "https://github.com/authup/authup#readme",
    "dependencies": {
        "@authup/client-admin-console": "^1.0.0-beta.58",
        "@authup/errors": "^1.0.0-beta.58",
        "@authup/kit": "^1.0.0-beta.58",
        "@authup/server-core": "^1.0.0-beta.58",
        "citty": "^0.2.2",
        "confinity": "^2.0.1",
        "consola": "^3.4.0",
        "locter": "^4.1.0",
        "resolve-package-path": "^4.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "cross-env": "^10.1.0",
        "vitest": "^4.0.18"
    }
}
