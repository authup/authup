{
    "name": "authup",
    "type": "module",
    "version": "1.0.0-beta.64",
    "description": "This is the CLI for the authup ecosystem.",
    "license": "AGPL-3.0-only",
    "files": [
        "dist"
    ],
    "scripts": {
        "cli": "node dist/index.mjs",
        "cli-dev": "npm run build && npm run cli",
        "dev": "node --conditions=authup-source --loader ts-node/esm src/index.ts dev",
        "build:js": "tsdown",
        "build": "rimraf ./dist && npm run build:js",
        "check:types": "tsc -p tsconfig.test.json",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.ts",
        "test:smoke": "node test/smoke/run.mjs",
        "test:smoke:packed": "node test/smoke/run.mjs --packed"
    },
    "engines": {
        "node": "^22.13.0 || ^23.5.0 || >=24.0.0"
    },
    "bin": {
        "authup": "dist/index.mjs"
    },
    "keywords": [
        "auth",
        "authentication",
        "authorization",
        "cli",
        "command-line",
        "oauth2",
        "server",
        "identity"
    ],
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/authup/authup.git",
        "directory": "packages/authup"
    },
    "bugs": {
        "url": "https://github.com/authup/authup/issues"
    },
    "homepage": "https://github.com/authup/authup#readme",
    "dependencies": {
        "@authup/errors": "^1.0.0-beta.64",
        "@authup/kit": "^1.0.0-beta.64",
        "@authup/server-account-console": "^1.0.0-beta.64",
        "@authup/server-admin-console": "^1.0.0-beta.64",
        "@authup/server-auth-console": "^1.0.0-beta.64",
        "@authup/server-config-kit": "^1.0.0-beta.64",
        "@authup/server-console-kit": "^1.0.0-beta.64",
        "@authup/server-core": "^1.0.0-beta.64",
        "citty": "^0.2.2",
        "dotenv": "^17.4.1",
        "eldin": "^1.3.0",
        "orkos": "^1.1.1",
        "reflect-metadata": "^0.2.2",
        "routup": "^6.1.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@authup/client-auth-console": "^1.0.0-beta.64",
        "@routup/basic": "^3.0.0",
        "better-sqlite3": "^13.0.3",
        "cross-env": "^10.1.0",
        "get-port-please": "^3.2.0",
        "ts-node": "^10.8.2",
        "vite": "^8.2.2",
        "vitest": "^4.0.18"
    }
}
