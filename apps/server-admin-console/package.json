{
    "name": "@authup/server-admin-console",
    "type": "module",
    "version": "1.0.0-beta.77",
    "description": "The service that serves the Authup admin console with its runtime configuration and theme.",
    "license": "AGPL-3.0-only",
    "bin": {
        "authup-admin-console": "dist/bin.mjs"
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        }
    },
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "rimraf ./dist && npm run build:js && npm run build:types",
        "check:types": "tsc -p tsconfig.test.json",
        "start": "node dist/bin.mjs",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.ts"
    },
    "engines": {
        "node": ">=26.0.0"
    },
    "keywords": [
        "auth",
        "console",
        "server"
    ],
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/authup/authup.git",
        "directory": "apps/server-admin-console"
    },
    "bugs": {
        "url": "https://github.com/authup/authup/issues"
    },
    "homepage": "https://github.com/authup/authup#readme",
    "dependencies": {
        "@authup/client-admin-console": "^1.0.0-beta.77",
        "@authup/kit": "^1.0.0-beta.77",
        "@authup/server-config": "^1.0.0-beta.77",
        "@authup/server-config-kit": "^1.0.0-beta.77",
        "@authup/server-console-kit": "^1.0.0-beta.77",
        "@ebec/http": "^4.3.2",
        "@routup/assets": "^6.1.0",
        "@routup/basic": "^3.1.0",
        "orkos": "^1.1.1",
        "routup": "^6.5.1",
        "validup": "^2.0.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.7",
        "cross-env": "^10.1.0",
        "vitest": "^5.1.1"
    },
    "publishConfig": {
        "access": "public"
    }
}
