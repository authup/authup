{
    "extends": "../../tsconfig.build.json",

    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        // No dependency of this package emits a `/// <reference types="node" />`,
        // so the node globals are not auto-discovered the way they are in the
        // workspaces that pull typeorm or vite.
        "types": ["node"]
    },

    "include": [
        "src/**/*.ts"
    ]
}
