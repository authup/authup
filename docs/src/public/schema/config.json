{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Authup configuration",
    "type": "object",
    "properties": {
        "env": {
            "type": "string",
            "description": "Application environment, e.g. production or development.",
            "x-authup-env": "NODE_ENV"
        },
        "rootPath": {
            "type": "string",
            "description": "Root directory every relative path key resolves against."
        },
        "server": {
            "type": "object",
            "properties": {
                "core": {
                    "type": "object",
                    "properties": {
                        "writableDirectoryPath": {
                            "type": "string",
                            "description": "Directory the application writes to at runtime (production log files) and reads file-based provisioning from. The SQLite database is not placed here; a relative path resolves against rootPath.",
                            "default": "writable",
                            "x-authup-env": "WRITABLE_DIRECTORY_PATH"
                        },
                        "logger": {
                            "type": "boolean",
                            "description": "Enable the application logger.",
                            "default": true
                        },
                        "componentsEnabled": {
                            "type": "boolean",
                            "description": "Run the background components (the cron sweeps) in this process. Set false on API replicas when a dedicated worker process runs them.",
                            "default": true,
                            "x-authup-env": "COMPONENTS_ENABLED"
                        },
                        "migrationEnabled": {
                            "type": "boolean",
                            "description": "Apply pending schema migrations at startup. When false, startup runs no DDL and fails loud when migrations are pending; the migration CLI command is unaffected and sqlite always synchronizes.",
                            "default": true,
                            "x-authup-env": "MIGRATION_ENABLED"
                        },
                        "port": {
                            "type": "number",
                            "minimum": 0,
                            "description": "TCP port the HTTP listener binds.",
                            "default": 3001,
                            "x-authup-env": "PORT"
                        },
                        "host": {
                            "type": "string",
                            "description": "Host address the HTTP listener binds.",
                            "default": "0.0.0.0",
                            "x-authup-env": "HOST"
                        },
                        "mtlsPublicUrl": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "format": "uri"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Optional externally reachable base URL dedicated to endpoints that request TLS client certificates, published as RFC 8705 mTLS endpoint aliases. The reverse proxy may route it to the same backend listener.",
                            "default": null,
                            "x-authup-env": "MTLS_PUBLIC_URL"
                        },
                        "certificateSource": {
                            "type": "string",
                            "enum": [
                                "disabled",
                                "standard",
                                "forwarded"
                            ],
                            "description": "Trusted-proxy client-certificate header contract: the RFC 9440 Client-Cert headers (standard) or the X-Forwarded-Tls-Client-Cert header (forwarded). Enabling a source asserts that the backend listener is reachable only through a proxy that removes or overwrites the selected headers.",
                            "default": "disabled",
                            "x-authup-env": "CERTIFICATE_SOURCE"
                        },
                        "trustProxy": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                },
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            ],
                            "description": "Which upstream proxies to trust when deriving the client IP from X-Forwarded-For: true trusts every hop, false trusts none, a number trusts that many hops, a string or string list is a proxy-addr allowlist (IPs, CIDRs, or the presets loopback, linklocal, uniquelocal). SECURITY: with every hop trusted any direct client can spoof its IP into the login throttle, the audit log and the session inventory; pin the actual proxy when the listener is reachable without one.",
                            "default": true,
                            "x-authup-env": "TRUST_PROXY"
                        },
                        "middlewareBody": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "object",
                                    "propertyNames": {
                                        "type": "string"
                                    },
                                    "additionalProperties": {}
                                }
                            ],
                            "description": "Enable the body-parsing middleware, or pass its options.",
                            "default": true
                        },
                        "middlewareCors": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "object",
                                    "propertyNames": {
                                        "type": "string"
                                    },
                                    "additionalProperties": {}
                                }
                            ],
                            "description": "Enable the CORS middleware, or pass its options.",
                            "default": true
                        },
                        "middlewareCookie": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "object",
                                    "propertyNames": {
                                        "type": "string"
                                    },
                                    "additionalProperties": {}
                                }
                            ],
                            "description": "Enable the cookie-parsing middleware, or pass its options.",
                            "default": true
                        },
                        "middlewarePrometheus": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "object",
                                    "propertyNames": {
                                        "type": "string"
                                    },
                                    "additionalProperties": {}
                                }
                            ],
                            "description": "Enable the Prometheus metrics middleware, or pass its options.",
                            "default": true
                        },
                        "middlewareQuery": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "object",
                                    "propertyNames": {
                                        "type": "string"
                                    },
                                    "additionalProperties": {}
                                }
                            ],
                            "description": "Enable the query-parsing middleware, or pass its options.",
                            "default": true
                        },
                        "middlewareRateLimit": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "object",
                                    "propertyNames": {
                                        "type": "string"
                                    },
                                    "additionalProperties": {}
                                }
                            ],
                            "description": "Enable the rate-limit middleware, or pass its options.",
                            "default": true
                        },
                        "middlewareSwagger": {
                            "type": "boolean",
                            "description": "Serve the Swagger UI and the OpenAPI document.",
                            "default": true
                        },
                        "tokenRefreshMaxAge": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Refresh token validity in seconds.",
                            "default": 259200,
                            "x-authup-env": "TOKEN_REFRESH_MAX_AGE"
                        },
                        "tokenAccessMaxAge": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Access token validity in seconds.",
                            "default": 900,
                            "x-authup-env": "TOKEN_ACCESS_MAX_AGE"
                        },
                        "tokenRefreshGracePeriod": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Grace period in seconds during which a just-rotated refresh token is still accepted, minting new chain-linked tokens instead of triggering replay detection. Absorbs multi-tab and mobile refresh races; zero is strict (first use wins).",
                            "default": 0,
                            "x-authup-env": "TOKEN_REFRESH_GRACE_PERIOD"
                        },
                        "promptLoginMaxAge": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Max age in seconds of the authentication a prompt=login or max_age authorize request accepts before forcing re-authentication, judged against the session creation time.",
                            "default": 60,
                            "x-authup-env": "PROMPT_LOGIN_MAX_AGE"
                        },
                        "endSessionHintGracePeriod": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Seconds past its expiry an expired id_token_hint presented at the RP-initiated logout endpoint is still accepted for a server-side session revoke. Zero accepts any expired hint; beyond the window the click-gated confirm page still works.",
                            "default": 0,
                            "x-authup-env": "END_SESSION_HINT_GRACE_PERIOD"
                        },
                        "registrationEnabled": {
                            "type": "boolean",
                            "description": "Enable user self-registration.",
                            "default": false,
                            "x-authup-env": "REGISTRATION_ENABLED"
                        },
                        "emailVerificationEnabled": {
                            "type": "boolean",
                            "description": "Require email verification for registration or login.",
                            "default": false,
                            "x-authup-env": "EMAIL_VERIFICATION_ENABLED"
                        },
                        "passwordRecoveryEnabled": {
                            "type": "boolean",
                            "description": "Allow password reset via email.",
                            "default": false,
                            "x-authup-env": "PASSWORD_RECOVERY_ENABLED"
                        },
                        "passwordMinLength": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 512,
                            "description": "Minimum length for user-chosen passwords (user create and update, registration, password reset). The maximum is fixed at 512.",
                            "default": 10,
                            "x-authup-env": "PASSWORD_MIN_LENGTH"
                        },
                        "eventLogEnabled": {
                            "type": "boolean",
                            "description": "Persist security audit events (login, authorize, replay detection) to the auth_events table. When disabled only the structured log line is emitted.",
                            "default": true,
                            "x-authup-env": "EVENT_LOG_ENABLED"
                        },
                        "eventLogRetentionDays": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Per-row retention for persisted audit events in days, stamped at write time and swept by the event cleaner. Zero keeps rows forever.",
                            "default": 90,
                            "x-authup-env": "EVENT_LOG_RETENTION_DAYS"
                        },
                        "eventLogEntityEnabled": {
                            "type": "boolean",
                            "description": "Additionally mirror every entity create, update and delete published on the domain-event bus into the auth_events table. Only effective while eventLogEnabled is true.",
                            "default": true,
                            "x-authup-env": "EVENT_LOG_ENTITY_ENABLED"
                        },
                        "eventLogEntityRetentionDays": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Per-row retention for entity-CRUD audit events in days, deliberately short so entity churn self-prunes. Zero keeps rows forever.",
                            "default": 7,
                            "x-authup-env": "EVENT_LOG_ENTITY_RETENTION_DAYS"
                        },
                        "loginAttemptThrottleEnabled": {
                            "type": "boolean",
                            "description": "Throttle failed interactive logins per (identifier, ip) pair by counting recent loginFailed audit events. Requires eventLogEnabled.",
                            "default": false,
                            "x-authup-env": "LOGIN_ATTEMPT_THROTTLE_ENABLED"
                        },
                        "loginAttemptThreshold": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "description": "Failed attempts per (identifier, ip) pair within the window before the pair is throttled.",
                            "default": 5,
                            "x-authup-env": "LOGIN_ATTEMPT_THRESHOLD"
                        },
                        "loginAttemptWindow": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "description": "Sliding login-throttle window in seconds.",
                            "default": 900,
                            "x-authup-env": "LOGIN_ATTEMPT_WINDOW"
                        },
                        "secretsEncryptionKey": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "const": ""
                                },
                                {
                                    "type": "string",
                                    "format": "base64",
                                    "contentEncoding": "base64",
                                    "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
                                }
                            ],
                            "description": "Optional base64-encoded 32-byte key (AES-256-GCM) wrapping the realm key store material at rest; an empty value leaves the material unwrapped (Keycloak and authentik parity). SECURITY: setting it later wraps rows lazily on read, and removing it while wrapped rows exist fails loud at first use.",
                            "default": "",
                            "x-authup-env": "SECRETS_ENCRYPTION_KEY"
                        },
                        "mfaEnabled": {
                            "type": "boolean",
                            "description": "Multi-factor authentication feature toggle. When enabled, users can enroll authenticator devices, and a user holding a confirmed device must present a second factor on interactive authorization and the password grant.",
                            "default": false,
                            "x-authup-env": "MFA_ENABLED"
                        },
                        "mfaRequired": {
                            "type": "boolean",
                            "description": "Enforce MFA for every user: a user without a confirmed device is routed to inline enrollment at the next interactive login. Requires mfaEnabled.",
                            "default": false,
                            "x-authup-env": "MFA_REQUIRED"
                        },
                        "mfaFreshnessMaxAge": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Max age in seconds of the session second-factor proof an acr_values=urn:authup:mfa step-up request accepts before forcing a fresh challenge. The window absorbs the hosted challenge round-trip.",
                            "default": 60,
                            "x-authup-env": "MFA_FRESHNESS_MAX_AGE"
                        },
                        "mfaTicketMaxAge": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "description": "Lifetime in seconds of the MFA-pending login ticket the password grant issues when the second factor cannot ride the single POST (email, WebAuthn), and of the pending session backing it. Sized to cover the email OTP window.",
                            "default": 600,
                            "x-authup-env": "MFA_TICKET_MAX_AGE"
                        },
                        "clientAuthBasic": {
                            "type": "boolean",
                            "description": "Accept HTTP Basic authentication with client credentials on the management API.",
                            "default": false,
                            "x-authup-env": "CLIENT_AUTH_BASIC"
                        },
                        "clientSystemEnabled": {
                            "type": "boolean",
                            "description": "Provision the system client in the master realm.",
                            "default": false,
                            "x-authup-env": "CLIENT_SYSTEM_ENABLED"
                        },
                        "clientSystemSecret": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 256,
                            "description": "Secret of the system client.",
                            "default": "start123",
                            "x-authup-env": "CLIENT_SYSTEM_SECRET"
                        },
                        "clientSystemSecretReset": {
                            "type": "boolean",
                            "description": "Reset the system client secret on application startup.",
                            "default": false,
                            "x-authup-env": "CLIENT_SYSTEM_SECRET_RESET"
                        },
                        "userAuthBasic": {
                            "type": "boolean",
                            "description": "Accept HTTP Basic authentication with user credentials on the management API.",
                            "default": false,
                            "x-authup-env": "USER_AUTH_BASIC"
                        },
                        "userAdminEnabled": {
                            "type": "boolean",
                            "description": "Provision the default admin user.",
                            "default": true,
                            "x-authup-env": "USER_ADMIN_ENABLED"
                        },
                        "userAdminPassword": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 256,
                            "description": "Password of the default admin user.",
                            "default": "start123",
                            "x-authup-env": "USER_ADMIN_PASSWORD"
                        },
                        "userAdminPasswordReset": {
                            "type": "boolean",
                            "description": "Reset the admin password on application startup.",
                            "default": false,
                            "x-authup-env": "USER_ADMIN_PASSWORD_RESET"
                        },
                        "permissions": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            ],
                            "description": "Additional permission names to provision, as a list or a comma-separated string.",
                            "default": [],
                            "x-authup-env": "PERMISSIONS"
                        },
                        "permissionsDefaultPolicyAssignment": {
                            "type": "boolean",
                            "description": "Auto-assign the system.default policy to new permissions without policies. Deprecated, to be removed in v2.0.0: external systems should assign policies explicitly.",
                            "default": true,
                            "x-authup-env": "PERMISSIONS_DEFAULT_POLICY_ASSIGNMENT"
                        }
                    }
                },
                "authConsole": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "EXPERIMENTAL. Package directory of a substituted @authup/client-auth-console, consulted before the node_modules resolution walk; an empty value resolves the package from node_modules. The substitute replaces the login and consent implementation, not its styling.",
                            "default": "",
                            "x-authup-env": "AUTH_CONSOLE_PATH"
                        },
                        "url": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "const": ""
                                },
                                {
                                    "type": "string",
                                    "format": "uri"
                                }
                            ],
                            "description": "Where the auth console service (@authup/server-auth-console) is served, e.g. https://example.com/console/auth. The hosted login, consent and workflow page GETs redirect there. An empty value derives it from publicUrl, which is the single-origin default.",
                            "default": "",
                            "x-authup-env": "AUTH_CONSOLE_URL"
                        }
                    }
                },
                "accountConsole": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "Package directory of a substituted @authup/client-account-console, consulted before the node_modules resolution walk; an empty value resolves the package from node_modules.",
                            "default": "",
                            "x-authup-env": "ACCOUNT_CONSOLE_PATH"
                        },
                        "enabled": {
                            "type": "boolean",
                            "description": "Serve the account self-service console at /console/account (profile, password, authenticators, sessions, applications). Operators with their own self-service portal can disable it.",
                            "default": true,
                            "x-authup-env": "ACCOUNT_CONSOLE_ENABLED"
                        }
                    }
                },
                "adminConsole": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "Package directory of a substituted @authup/client-admin-console, consulted before the node_modules resolution walk; an empty value resolves the package from node_modules.",
                            "default": "",
                            "x-authup-env": "ADMIN_CONSOLE_PATH"
                        },
                        "enabled": {
                            "type": "boolean",
                            "description": "Serve the admin console at /console/admin. Off, the route answers with the disabled notice; a standalone-hosted console is unaffected.",
                            "default": true,
                            "x-authup-env": "ADMIN_CONSOLE_ENABLED"
                        }
                    }
                }
            }
        },
        "theme": {
            "type": "object",
            "properties": {
                "directoryPath": {
                    "type": "string",
                    "description": "EXPERIMENTAL. Directory holding the operator theme applied to the served consoles (its assets are served at /theme, its theme.json injects CSS custom properties); an empty value disables theming. SECURITY: the directory is operator trust, mount it read-only and never from a source a tenant can write.",
                    "default": "",
                    "x-authup-env": "THEME_DIRECTORY_PATH"
                },
                "fragmentsEnabled": {
                    "type": "boolean",
                    "description": "EXPERIMENTAL. Opt in to splicing fragments/head.html from the theme directory into the head of both served consoles. SECURITY: the fragment is raw, unsanitized markup running on the IdP origin, so enabling it must be a deliberate operator decision.",
                    "default": false,
                    "x-authup-env": "THEME_FRAGMENTS_ENABLED"
                }
            }
        },
        "db": {
            "description": "Database connection (TypeORM data source options). Without one the better-sqlite3 driver default of typeorm-extension applies."
        },
        "redis": {
            "anyOf": [
                {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "boolean"
                        }
                    ]
                },
                {}
            ],
            "description": "Redis connection: a connection URL, client options, an existing client, or a boolean to use the default connection or run without Redis.",
            "default": false,
            "x-authup-env": "REDIS"
        },
        "smtp": {
            "anyOf": [
                {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "boolean"
                        }
                    ]
                },
                {}
            ],
            "description": "SMTP transport for outgoing mail: a connection URL, transport options, or a boolean to use the default transport or run without mail.",
            "default": false,
            "x-authup-env": "SMTP"
        },
        "publicUrl": {
            "type": "string",
            "format": "uri",
            "description": "Externally reachable base URL of the API. Derived from host and port when unset.",
            "x-authup-env": "PUBLIC_URL"
        },
        "trustedOrigins": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Trusted first-party app origins besides publicUrl, used as redirect targets for the per-realm public system clients; entries are http(s) origins or bare hosts (a bare host expands to its http and https origin) and do not drive CORS. SECURITY: the system clients auto-consent with the global scope, so every origin listed here can obtain a full-permission user token in every realm.",
            "default": [],
            "x-authup-env": "TRUSTED_ORIGINS"
        }
    }
}
