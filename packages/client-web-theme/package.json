{
  "name": "@authup/client-web-theme",
  "type": "module",
  "version": "1.0.0-beta.64",
  "description": "Authup theme for vuecs components, built on top of @vuecs/theme-tailwind.",
  "license": "Apache-2.0",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./assets/css/index.css",
      "import": "./dist/index.mjs"
    },
    "./index.css": "./assets/css/index.css"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "assets",
    "dist"
  ],
  "scripts": {
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "build:js": "tsdown",
    "build": "rimraf ./dist && npm run build:js && npm run build:types",
    "check:types": "tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": "^22.13.0 || ^23.5.0 || >=24.0.0"
  },
  "keywords": [
    "authup",
    "vuecs",
    "theme",
    "tailwindcss",
    "ui-theme"
  ],
  "author": {
    "name": "Peter Placzek",
    "email": "contact@tada5hi.net",
    "url": "https://github.com/tada5hi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authup/authup.git",
    "directory": "packages/client-web-theme"
  },
  "bugs": {
    "url": "https://github.com/authup/authup/issues"
  },
  "homepage": "https://github.com/authup/authup#readme",
  "dependencies": {
    "@authup/client-web-kit-theme": "^1.0.0-beta.64"
  },
  "devDependencies": {
    "@vuecs/button": "^1.4.1",
    "@vuecs/core": "^3.5.0",
    "@vuecs/design": "^1.2.0",
    "@vuecs/navigation": "^4.5.0",
    "@vuecs/table": "^1.6.1",
    "@vuecs/theme-tailwind": "^6.4.2",
    "tailwindcss": "^4.3.2"
  },
  "peerDependencies": {
    "@vuecs/core": "^3.5.0",
    "@vuecs/design": "^1.2.0",
    "@vuecs/theme-tailwind": "^6.4.2",
    "tailwindcss": "^4.3.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
