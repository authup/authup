{
    "name": "@authup/errors",
    "type": "module",
    "version": "1.0.0-beta.57",
    "description": "Package containing error codes and basic error classes.",
    "license": "Apache-2.0",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        }
    },
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "rimraf ./dist && npm run build:js && npm run build:types",
        "test": "cross-env NODE_ENV=test vitest run test/unit"
    },
    "engines": {
        "node": "^22.13.0 || ^23.5.0 || >=24.0.0"
    },
    "keywords": [
        "auth",
        "error",
        "error-codes",
        "http-error",
        "oauth2",
        "jwt",
        "authentication",
        "authorization"
    ],
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/authup/authup.git",
        "directory": "packages/errors"
    },
    "bugs": {
        "url": "https://github.com/authup/authup/issues"
    },
    "homepage": "https://github.com/authup/authup#readme",
    "dependencies": {
        "@ebec/core": "^1.2.0",
        "validup": "^0.5.1"
    },
    "devDependencies": {
        "vitest": "^4.0.14"
    },
    "publishConfig": {
        "access": "public"
    }
}
