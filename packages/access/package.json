{
    "name": "@authup/access",
    "type": "module",
    "version": "1.0.0-beta.62",
    "description": "A library for evaluating permissions and policies.",
    "license": "Apache-2.0",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        }
    },
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "rimraf ./dist && npm run build:js && npm run build:types",
        "test": "cross-env NODE_ENV=test vitest run",
        "test:coverage": "cross-env NODE_ENV=test vitest run --coverage"
    },
    "engines": {
        "node": "^22.13.0 || ^23.5.0 || >=24.0.0"
    },
    "keywords": [
        "auth",
        "authorization",
        "permission",
        "policy",
        "rbac",
        "abac",
        "access-control",
        "policy-engine",
        "permission-evaluator",
        "decision-strategy"
    ],
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/authup/authup.git",
        "directory": "packages/access"
    },
    "bugs": {
        "url": "https://github.com/authup/authup/issues"
    },
    "homepage": "https://github.com/authup/authup#readme",
    "dependencies": {
        "@authup/errors": "^1.0.0-beta.62",
        "@authup/kit": "^1.0.0-beta.62",
        "@ebec/core": "^1.3.2",
        "@rapiq/adapter-memory": "^2.2.0",
        "@rapiq/core": "^2.2.0",
        "@rapiq/parser-mongo": "^2.2.0",
        "@validup/zod": "^2.0.1",
        "smob": "^1.6.1",
        "validup": "^2.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "unplugin-swc": "^1.5.10",
        "vitest": "^4.0.14"
    },
    "publishConfig": {
        "access": "public"
    }
}
