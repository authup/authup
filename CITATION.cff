# This CITATION.cff file provides citation metadata for Authup.
# GitHub renders a "Cite this repository" button from it, and Zenodo uses
# it (alongside .zenodo.json) when minting a DOI for a release.
# Format reference: https://citation-file-format.github.io
cff-version: 1.2.0
message: "If you use this software, please cite it using the metadata from this file."
title: "Authup"
abstract: >-
  Authup is a flexible authentication and authorization system. It provides
  identity- and access-management with support for multiple authentication
  strategies and standard protocols — OAuth2.0, OpenID Connect and LDAP —
  alongside claim-, subject- and attribute-based authorization. The monorepo
  bundles the core server service, a Nuxt web client, a command-line interface
  and a set of shared TypeScript client libraries and server adapters.
type: software
authors:
  - given-names: Peter
    family-names: Placzek
    email: contact@tada5hi.net
    website: "https://tada5hi.net"
    orcid: "https://orcid.org/0009-0004-1237-105X"
    # affiliation: ""  # add your institution
repository-code: "https://github.com/authup/authup"
url: "https://authup.org"
# Concept DOI (all-versions) — always resolves to the latest release on Zenodo.
doi: "10.5281/zenodo.20836542"
identifiers:
  - type: doi
    value: "10.5281/zenodo.20836542"
    description: "Concept DOI (all versions)"
# Authup is dual-licensed: the applications (server-core, client-web, authup CLI)
# under AGPL-3.0-only (+ commercial), all packages under Apache-2.0.
license:
  - AGPL-3.0-only
  - Apache-2.0
version: 1.0.0-beta.57 # x-release-please-version
# date-released: 2026-01-01  # set/automate to the release date of `version`
keywords:
  - authentication
  - authorization
  - identity and access management
  - oauth2
  - openid-connect
  - ldap
  - single-sign-on
